# App
NODE_ENV=local
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:4200
# 'strict'/'lax' when frontend+API share one origin behind a reverse proxy.
# 'none' when they're deployed as two separate origins (e.g. two Render services) —
# required for the refresh-token cookie to survive a cross-site request.
COOKIE_SAME_SITE=strict

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=atarlab
DB_PASSWORD=atarlab_dev
DB_NAME=atarlab
DB_SSL=false
DB_POOL_SIZE=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Mail (sandbox: use Mailtrap/Ethereal in local/staging)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=changeme
MAIL_PASSWORD=changeme
MAIL_FROM="AtarLab <no-reply@atarlab.com>"

# Razorpay (test/sandbox keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change-me
RAZORPAY_WEBHOOK_SECRET=change-me

# Storage (Cloudinary sandbox)
CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me

# Frontend URL (for email links / OAuth redirect)
FRONTEND_URL=http://localhost:4200

# Backend's own public URL (used to build local-disk upload URLs when Cloudinary isn't configured)
BACKEND_PUBLIC_URL=http://localhost:3000

# Error monitoring (left blank => Sentry SDK no-ops; add a project DSN from sentry.io to enable)
SENTRY_DSN=
